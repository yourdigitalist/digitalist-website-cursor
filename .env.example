# Supabase — project ref: exyqeotxncuzqeadreid (only this project is used)
# Copy to .env.local for development. Set the same keys in Vercel → Project → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://exyqeotxncuzqeadreid.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: seed script (npm run seed:supabase). Never expose in client code or commit real values.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — contact form (`/api/contact`). Server-only; never expose the API key.
RESEND_API_KEY=
# Example testing: Digitalist <onboarding@resend.dev>
# Production: use a verified domain in Resend, e.g. Digitalist <hello@yourdigitalist.com>
RESEND_FROM=
# Where inbound notifications are delivered (defaults to marina@yourdigitalist.com if unset)
CONTACT_TO_EMAIL=
